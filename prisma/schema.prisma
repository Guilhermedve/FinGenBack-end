generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  
}

model User {
  id    Int    @id @default(autoincrement())
  email String @unique
  name  String
}

model Transaction {
  id          Int       @id @default(autoincrement())
  amount    Int
  date      DateTime? @default(now())
  userId    Int
  description String
}

model Purchase {
  id        Int      @id @default(autoincrement())
  item      String
  price     Float
  date      DateTime
  userId    Int
}
